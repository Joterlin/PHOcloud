# Servidor local
PORT=3000
NODE_ENV=development
PHOCLOUD_PUBLIC_URL=http://localhost:3000

# Correo por API HTTPS (recomendado en Railway Free/Trial/Hobby)
# RESEND_API_KEY=re_xxxxxxxxx
# PHOCLOUD_FROM_EMAIL=The Real Gallery <noreply@example.invalid>

# Correo SMTP alternativo (opcional durante el desarrollo local o Railway Pro)
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# PHOCLOUD_FROM_EMAIL=The Real Gallery <noreply@example.invalid>

# Configuración legal. Privacidad y Términos solo muestran país y correo profesional.
# Nombre, domicilio y NIF no se insertan en esas páginas sin una revisión jurídica.
# Los ejemplos .invalid se rechazan en producción a propósito.
# Usa únicamente valores reales revisados y un buzón profesional ya operativo.
# Datos de identidad opcionales reservados para un aviso legal revisado.
# No se muestran actualmente en Términos ni Privacidad.
# PHOCLOUD_LEGAL_NAME=Nombre o razón social
# PHOCLOUD_LEGAL_EMAIL=legal@example.invalid
# PHOCLOUD_LEGAL_COUNTRY=España
# PHOCLOUD_LEGAL_ADDRESS=Domicilio legal o establecimiento permanente
# PHOCLOUD_LEGAL_TAX_ID=NIF del prestador
# PHOCLOUD_LEGAL_REGISTRY=Datos registrales, solo si resultan aplicables
# PHOCLOUD_SECURITY_EMAIL=security@example.invalid

# Rutas persistentes (obligatorias en producción)
# PHOCLOUD_DATABASE_PATH=C:\ruta\data\phocloud.db
# PHOCLOUD_UPLOADS_DIRECTORY=C:\ruta\uploads
# PHOCLOUD_TRANSFERS_DIRECTORY=C:\ruta\transfers
# PHOCLOUD_BACKUP_DIRECTORY=C:\ruta\backups
# PHOCLOUD_BACKUP_RETENTION_DAYS=30
# PHOCLOUD_AUTOMATIC_BACKUPS=false
# PHOCLOUD_BACKUP_INTERVAL_HOURS=24
# Opcional: usa credenciales y bucket separados. Si se omiten, se reutiliza el R2 de galerías.
# PHOCLOUD_BACKUP_R2_ACCESS_KEY_ID=clave_de_acceso
# PHOCLOUD_BACKUP_R2_SECRET_ACCESS_KEY=clave_secreta
# PHOCLOUD_BACKUP_R2_BUCKET=phocloud-backups

# Transferencias grandes en Cloudflare R2 (recomendado en producción)
# PHOCLOUD_TRANSFER_STORAGE=r2
# PHOCLOUD_R2_ACCOUNT_ID=identificador_de_cuenta
# PHOCLOUD_R2_ACCESS_KEY_ID=clave_de_acceso
# PHOCLOUD_R2_SECRET_ACCESS_KEY=clave_secreta
# PHOCLOUD_R2_BUCKET=phocloud-transfers
# PHOCLOUD_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Galerías permanentes en un segundo bucket R2 sin caducidad
# PHOCLOUD_GALLERY_STORAGE=r2
# PHOCLOUD_GALLERY_R2_ACCESS_KEY_ID=clave_de_acceso
# PHOCLOUD_GALLERY_R2_SECRET_ACCESS_KEY=clave_secreta
# PHOCLOUD_GALLERY_R2_BUCKET=phocloud-galleries

# Protección económica. Los interruptores no borran archivos ni bloquean el panel.
PHOCLOUD_ACCEPT_NEW_TRANSFERS=true
PHOCLOUD_ZIP_ENABLED=true
# Pausa solo nuevas conversiones transferencia -> galería.
PHOCLOUD_CONVERSION_ENABLED=true
# Genera un valor largo y aleatorio; protege GET /operations/economics.
# PHOCLOUD_OPERATIONS_TOKEN=cambia_por_un_token_aleatorio
PHOCLOUD_UPLOAD_LEASE_MINUTES=180
PHOCLOUD_ZIP_LEASE_MINUTES=60
PHOCLOUD_GLOBAL_CONCURRENT_UPLOADS=8
PHOCLOUD_GLOBAL_CONCURRENT_ZIPS=2
PHOCLOUD_ACCOUNT_CONCURRENT_ZIPS=1
PHOCLOUD_GLOBAL_CONCURRENT_CONVERSIONS=2
PHOCLOUD_ACCOUNT_CONCURRENT_CONVERSIONS=1
PHOCLOUD_GLOBAL_MONTHLY_UPLOAD_GIB=2048
PHOCLOUD_GLOBAL_TRANSFER_STORAGE_GIB=250
PHOCLOUD_GLOBAL_MONTHLY_DOWNLOAD_GIB=4096
PHOCLOUD_GLOBAL_MONTHLY_ZIP_GIB=250
PHOCLOUD_GLOBAL_MONTHLY_ZIP_JOBS=1000
PHOCLOUD_GLOBAL_MONTHLY_ERROR_LIMIT=5000

# Límites por plan (capacidad técnica absoluta: 50 GiB por transferencia).
PHOCLOUD_FREE_TRANSFER_MAX_GIB=5
PHOCLOUD_FREE_MONTHLY_UPLOAD_GIB=5
PHOCLOUD_FREE_TRANSFER_STORAGE_GIB=5
PHOCLOUD_FREE_CONCURRENT_UPLOADS=1
PHOCLOUD_FREE_ZIP_MAX_GIB=1
PHOCLOUD_FREE_MONTHLY_ZIP_JOBS=1
PHOCLOUD_FREE_MONTHLY_ZIP_GIB=1
PHOCLOUD_CREATOR_TRANSFER_MAX_GIB=25
PHOCLOUD_CREATOR_MONTHLY_UPLOAD_GIB=250
PHOCLOUD_CREATOR_TRANSFER_STORAGE_GIB=50
PHOCLOUD_CREATOR_CONCURRENT_UPLOADS=2
PHOCLOUD_CREATOR_ZIP_MAX_GIB=5
PHOCLOUD_CREATOR_MONTHLY_ZIP_JOBS=5
PHOCLOUD_CREATOR_MONTHLY_ZIP_GIB=10
PHOCLOUD_PRO_TRANSFER_MAX_GIB=50
PHOCLOUD_PRO_MONTHLY_UPLOAD_GIB=1024
PHOCLOUD_PRO_TRANSFER_STORAGE_GIB=250
PHOCLOUD_PRO_CONCURRENT_UPLOADS=4
PHOCLOUD_PRO_ZIP_MAX_GIB=10
PHOCLOUD_PRO_MONTHLY_ZIP_JOBS=20
PHOCLOUD_PRO_MONTHLY_ZIP_GIB=50

# Suscripciones Stripe (inactivas hasta cambiar el interruptor a true)
# PHOCLOUD_BILLING_ENABLED=false
# STRIPE_RESTRICTED_KEY=rk_test_xxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# STRIPE_CREATOR_PRICE_ID=price_xxxxxxxxx
# STRIPE_PRO_PRICE_ID=price_xxxxxxxxx
