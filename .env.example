# Servidor local
PORT=3000
NODE_ENV=development
PHOCLOUD_PUBLIC_URL=http://localhost:3000

# Correo por API HTTPS (recomendado en Railway Free/Trial/Hobby)
# RESEND_API_KEY=re_xxxxxxxxx
# PHOCLOUD_FROM_EMAIL=The Real Gallery <onboarding@resend.dev>

# Correo SMTP alternativo (opcional durante el desarrollo local o Railway Pro)
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# PHOCLOUD_FROM_EMAIL=The Real Gallery <hola@tudominio.com>

# Datos legales (obligatorios en producción)
# PHOCLOUD_LEGAL_NAME=Nombre o razón social
# PHOCLOUD_LEGAL_EMAIL=privacidad@tudominio.com
# PHOCLOUD_LEGAL_COUNTRY=España

# Rutas persistentes (obligatorias en producción)
# PHOCLOUD_DATABASE_PATH=C:\ruta\data\phocloud.db
# PHOCLOUD_UPLOADS_DIRECTORY=C:\ruta\uploads
# PHOCLOUD_TRANSFERS_DIRECTORY=C:\ruta\transfers
# PHOCLOUD_BACKUP_DIRECTORY=C:\ruta\backups
# PHOCLOUD_BACKUP_RETENTION_DAYS=30
# PHOCLOUD_AUTOMATIC_BACKUPS=false
# PHOCLOUD_BACKUP_INTERVAL_HOURS=24
# Opcional: usa credenciales y bucket separados. Si se omiten, se reutiliza el R2 de galerías.
# PHOCLOUD_BACKUP_R2_ACCESS_KEY_ID=clave_de_acceso
# PHOCLOUD_BACKUP_R2_SECRET_ACCESS_KEY=clave_secreta
# PHOCLOUD_BACKUP_R2_BUCKET=phocloud-backups

# Transferencias grandes en Cloudflare R2 (recomendado en producción)
# PHOCLOUD_TRANSFER_STORAGE=r2
# PHOCLOUD_R2_ACCOUNT_ID=identificador_de_cuenta
# PHOCLOUD_R2_ACCESS_KEY_ID=clave_de_acceso
# PHOCLOUD_R2_SECRET_ACCESS_KEY=clave_secreta
# PHOCLOUD_R2_BUCKET=phocloud-transfers
# PHOCLOUD_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Galerías permanentes en un segundo bucket R2 sin caducidad
# PHOCLOUD_GALLERY_STORAGE=r2
# PHOCLOUD_GALLERY_R2_ACCESS_KEY_ID=clave_de_acceso
# PHOCLOUD_GALLERY_R2_SECRET_ACCESS_KEY=clave_secreta
# PHOCLOUD_GALLERY_R2_BUCKET=phocloud-galleries

# Suscripciones Stripe (inactivas hasta cambiar el interruptor a true)
# PHOCLOUD_BILLING_ENABLED=false
# STRIPE_RESTRICTED_KEY=rk_test_xxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
# STRIPE_CREATOR_PRICE_ID=price_xxxxxxxxx
# STRIPE_PRO_PRICE_ID=price_xxxxxxxxx
